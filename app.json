{
  "expo": {
    "name": "Pinterest Discovery & Sharing",
    "slug": "pinterest-photo-sharing",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=192&h=192&q=80",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=512&h=512&q=80",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f0f"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.pinterestphotosharing",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to let you pick and upload stunning pictures as Pins."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=192&h=192&q=80",
        "backgroundColor": "#0F0F0F"
      },
      "package": "com.anonymous.pinterestphotosharing",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=32&h=32&q=80",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos to allow uploading them as Pins on Pinterest Shared Boards."
        }
      ],
      "expo-router",
      "expo-font",
      "expo-secure-store"
    ],
    "scheme": "pinterest-discovery"
  }
}
